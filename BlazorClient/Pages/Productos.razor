@page "/productos"
@inject HttpClient Http

<h3>Lista de Productos</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="CargarProductos">Refrescar</button>
</div>

@if (productos == null)
{
    <p><em>Cargando productos...</em></p>
}
else if (!productos.Any())
{
    <p>No se encontraron productos.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Precio</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in productos)
            {
                <tr>
                    <td>@prod.Id</td>
                    <td>@prod.Nombre</td>
                    <td>@prod.Precio.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Producto>? productos;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        try
        {
            productos = await Http.GetFromJsonAsync<List<Producto>>("api/productos");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar productos: {ex.Message}");
        }
    }

    // Clase Producto interna
    public class Producto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal Precio { get; set; }
    }
}